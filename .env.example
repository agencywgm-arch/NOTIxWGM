# Copier vers .env puis remplir (valeurs publiques, sans risque côté client)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé publique VAPID (Web Push) — la clé privée reste côté Supabase
VITE_VAPID_PUBLIC_KEY=

# Base path du déploiement ("/" en local, "/<nom-du-repo>/" sur GitHub Pages)
VITE_BASE_PATH=/

# Firebase Phone Auth — vérification SMS (facultative) du numéro client.
# Optionnel : si absent, le bouton "Vérifier mon numéro" ne s'affiche pas.
# Copier depuis Console Firebase > Paramètres du projet > Vos applications.
# Nécessite d'activer la formule Blaze (carte bancaire) sur le projet, ET
# le fournisseur "Téléphone" dans Authentication > Sign-in method. L'envoi
# de SMS reste gratuit dans le quota mensuel Google pour un usage normal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
