# Copier vers .env puis remplir (valeurs publiques, sans risque côté client)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé publique VAPID (Web Push) — la clé privée reste côté Supabase
VITE_VAPID_PUBLIC_KEY=

# Base path du déploiement ("/" en local, "/<nom-du-repo>/" sur GitHub Pages)
VITE_BASE_PATH=/

# La vérification SMS du numéro client ne passe plus par Firebase (retiré) —
# elle tourne désormais sur le même canal Brevo que les relances, entièrement
# configuré côté secrets Supabase (SMS_PROVIDER, BREVO_API_KEY, SMS_SENDER).
# Rien à ajouter ici côté client.
